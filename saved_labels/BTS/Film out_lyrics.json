            "startChunk": 601,
            "endChunk": 734
        },
        "language": "Japanese",
        "memberName": [
            "Jungkook"
        ],
        "korean": "たんたんと降り積もった記憶の中で\n君だけを拾い集めて繫げて",
        "romanization": "tantan to furitsumotta kioku no naka de\nkimi dake o hiroiatsume te tsunage te",
        "english": "From all the memories stored in my heart\nI gather up the ones of you and link them together",
        "startChunk": 590,
        "isAdLib": false,
        "adLibDuration": 0,
        "anchorMode": "startChunk"
    },
