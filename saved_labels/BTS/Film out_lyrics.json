        ],
        "korean": "浮かび上がる君は\nあまりに鮮やかで Oh",
        "romanization": "ukabiagaru kimi wa\namari ni azayaka de Oh",
        "english": "You, in my imagination\nAre so vivid",
        "startChunk": 0,
        "isAdLib": false,
        "adLibDuration": 0,
        "anchorMode": "startChunk"
    },
    {
        "lyricId": "7fb61f15-1119-40cb-9d8b-42ca665bce8a",
        "linkedLabel": {
            "member": "Jimin",
            "startChunk": 305,
            "endChunk": 398
        },
        "language": "Japanese",
        "memberName": [
            "Jimin"
        ],
        "korean": "まるでそこにいるかと\n手を伸ばすところで\nふっと消えてしまう",
        "romanization": "marude soko ni iru ka to\nte o nobasu tokoro de\nfutto kiete shimau",
        "english": "As if you are right there\nBut I reach out my hand\nAnd you suddenly disappear",
        "startChunk": 294,
        "isAdLib": false,
        "adLibDuration": 0,
        "anchorMode": "startChunk"
    },
    {
